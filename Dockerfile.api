# ─── Stage 1: Install & Build ─────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Enable pnpm 9 via corepack
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy all workspace files needed for dependency resolution
COPY . .

# Install all dependencies using frozen lockfile
RUN pnpm install --frozen-lockfile

# Build the API (esbuild bundles src → dist/index.mjs)
RUN pnpm --filter @workspace/api-server run build

# Create a standalone production deploy with flat node_modules
RUN pnpm --filter @workspace/api-server deploy --prod /standalone


# ─── Stage 2: Production Runner ───────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

# Copy flat production node_modules from pnpm deploy
COPY --from=builder /standalone/node_modules ./node_modules

# Copy compiled bundle from esbuild
COPY --from=builder /app/artifacts/api-server/dist ./dist

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
