# ─── Stage 1: Build Vite App ──────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy all workspace files
COPY . .

# Install all dependencies using frozen lockfile
RUN pnpm install --frozen-lockfile

# Build the frontend (outputs to artifacts/pw-clone/dist/public)
RUN pnpm --filter @workspace/pw-clone run build


# ─── Stage 2: Serve with Nginx ────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Copy built static files
COPY --from=builder /app/artifacts/pw-clone/dist/public /usr/share/nginx/html

# Copy nginx config (SPA routing + compression + caching)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
